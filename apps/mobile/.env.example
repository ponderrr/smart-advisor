# Runtime config for the Flutter app (client-public values only).
# Do NOT commit the real .env — it's git-ignored. Generate it with:
#   ./tool/sync-env.sh        (copies from repo-root .env.local)
# or copy this file to .env and fill in the values manually.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-client-public-anon-key
